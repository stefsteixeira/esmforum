classDiagram

class Usuario {
    +int id_usuario
    +string nome
}

class Pergunta {
    +int id_pergunta
    +string texto
    +int id_usuario
    +int pontuacao
}

class Resposta {
    +int id_resposta
    +int id_pergunta
    +string texto
}

class Voto {
    +int id_voto
    +int id_usuario
    +int id_pergunta
    +int valor
}

class Notificacao {
    +int id_notificacao
    +int id_usuario
    +int id_pergunta
    +string mensagem
    +boolean lida
}

Usuario "1" --> "0..*" Pergunta : cria
Usuario "1" --> "0..*" Voto : realiza
Usuario "1" --> "0..*" Notificacao : recebe
Pergunta "1" --> "0..*" Resposta : possui
Pergunta "1" --> "0..*" Voto : recebe
Pergunta "1" --> "0..*" Notificacao : gera